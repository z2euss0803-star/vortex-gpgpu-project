	mkdir -p $(OUT)
	$(CXX) $(UXFLAGS) -fno-fast-math -ffp-contract=off $< $(CPU_POOL_OBJECTS) -lm -Wl,--wrap=pthread_create -Wl,--wrap=pthread_join -Wl,--wrap=sysconf -o $@
