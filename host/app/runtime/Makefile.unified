	mkdir -p $(OUT)
	$(CC) $(UFLAGS) $< -o $@
$(OUT)/test_identity: tests/unified/test_identity.cpp include/vxunified/types.hpp
	mkdir -p $(OUT)
	$(CXX) $(UXFLAGS) $< -o $@
test-unified-wire: $(OUT)/test_wire
	$<
test-unified-identity: $(OUT)/test_identity
