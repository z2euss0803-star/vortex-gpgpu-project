# Independent next installation boundary; excluded from frozen scene687.
# Compile the actual installation translation unit. Link-time dead stripping
# keeps this metadata-only test independent of the later native service build;
# complete native installation is tested separately, never inferred here.
$(OUT)/install-decode/%.o: %.cpp $(SCHED_HEADERS)
	mkdir -p $(dir $@)
	$(CXX) $(UXFLAGS) $(NN_JSON_FLAGS) -ffunction-sections -fdata-sections -fno-fast-math -ffp-contract=off -c $< -o $@
$(OUT)/test_installed_media: $(OUT)/install-decode/tests/unified/test_installed_media.o $(OUT)/install-decode/unified/service/installation.o $(OUT)/nn/nnrt/package/canonical.o $(OUT)/nn/sha.o
	$(CXX) $(UXFLAGS) -Wl,--gc-sections $^ $(NN_JSON_LIBS) -lstdc++fs -lm -o $@

# Complete installed service linkage; this is deliberately distinct from the
# decoder-only test above and includes every production application provider.
INSTALLED_RUNTIME_LINK = $(filter-out $(OUT)/shared/unified/service/result.o $(OUT)/shared/unified/service/compute_port.o,$(sort $(MEDIA_LINK) $(NATIVE_NN_DAEMON_OBJECTS) $(OUT)/shared/unified/service/ingress_mux.o $(OUT)/nn-native/unified/service/joint_bridge.o $(OUT)/nn-native/unified/service/native_image_service.o $(OUT)/nn-native/unified/service/native_p8_service.o $(OUT)/nn-native/p8/texture_service.o $(OUT)/p8/texture_receiver.o $(OUT)/image/shared/unified/adapters/image_service.o $(OUT)/image/network/receiver_linux.o $(OUT)/image/network/original_protocol.o))
$(OUT)/nn-native/tests/unified/test_installed_image.o: UXFLAGS += -Ivendor/image-studio/src/vortex23-image-studio-720p-fast
$(OUT)/test_installed_image: $(OUT)/nn-native/tests/unified/test_installed_image.o $(INSTALLED_RUNTIME_LINK) $(OUT)/backend/tests/unified/image_owner_bridge.o
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) $(U18_DRM_LIBS) -lstdc++fs -lm -o $@
