	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) $(U18_DRM_LIBS) -lstdc++fs -lm -o $@

# Definitions must precede immediate prerequisite expansion in GNU make.
$(OUT)/test_native_daemon: $(OUT)/nn-native/tests/unified/test_native_daemon.o $(INSTALLED_RUNTIME_LINK) $(OUT)/backend/tests/unified/mosaic_owner_bridge.o
	$(CXX) $(UXFLAGS) $(filter %.o,$^) $(NN_JSON_LIBS) $(U18_DRM_LIBS) -lstdc++fs -lm -o $@
