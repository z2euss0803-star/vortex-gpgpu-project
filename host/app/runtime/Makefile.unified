	$(OUT)/test_backend $(OUT)/catalog-fixture.bin
# Every v2 consumer rebuilds for any wire/core header change. Final evidence
# runs also use fresh OUT directories rather than trusting incremental products.
V2_ALL_HEADERS = $(wildcard include/vxl/v2/*.h include/vxunified/*.hpp include/vxnn/*.hpp) include/uapi/vx_compute_v2.h
$(addprefix $(OUT)/,test_objects test_leases test_buffer_adapter test_catalog test_program_load test_relocate test_catalog_driver test_private_init test_job_jobs test_job_batch test_job_close test_job_poll test_dispatch test_control test_provider test_backend test_execution): $(V2_ALL_HEADERS)
$(addprefix $(OUT)/backend/,$(V2_BACKEND_C:.c=.o)) $(OUT)/backend/tests/unified/backend_bridge.o: $(V2_ALL_HEADERS) tests/v2/port_fixture.h tests/v2/jobs_fixture.h tests/v2/program_fixture.h

NN_PLAN_SOURCES = nnrt/package/canonical.cpp nnrt/package/reader.cpp nnrt/package/registry.cpp nnrt/graph/prepare.cpp nnrt/memory/planner.cpp
NN_PLAN_OBJECTS = $(addprefix $(OUT)/nn/,$(NN_PLAN_SOURCES:.cpp=.o)) $(OUT)/nn/sha.o
.SECONDARY: $(NN_PLAN_OBJECTS)
$(OUT)/nn/%.o: %.cpp $(wildcard include/vxnn/*.hpp include/vxunified/*.hpp nnrt/package/*.hpp)
	mkdir -p $(dir $@)
	$(CXX) $(UXFLAGS) $(NN_JSON_FLAGS) -c $< -o $@
$(OUT)/nn/sha.o: core/hunet_sha256.c
	mkdir -p $(dir $@)
	$(CC) $(UFLAGS) -c $< -o $@
$(OUT)/test_nn_%: tests/nnrt/test_%.cpp tests/nnrt/fixture.hpp $(NN_PLAN_OBJECTS)
	$(CXX) $(UXFLAGS) $(NN_JSON_FLAGS) $< $(NN_PLAN_OBJECTS) $(NN_JSON_LIBS) -lstdc++fs -o $@
$(OUT)/package-fixtures/.ready: tests/nnrt/package_fixture.py
	$(PYTHON) $< $(OUT)/package-fixtures
	touch $@
