CPU_POOL_OBJECTS = $(OUT)/shared/nnrt/cpu/pool.o $(OUT)/shared/nnrt/cpu/gelu.o
$(OUT)/test_cpu_%: tests/nnrt/test_%_pool.cpp $(CPU_POOL_OBJECTS) include/vxnn/cpu.hpp include/vxnn/types.hpp
	mkdir -p $(OUT)
