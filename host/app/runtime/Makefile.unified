PYTHON ?= python3
MOSAIC_WIRE_SOURCE ?= device/vxnn/mosaic_wire_ro64.cpp device/vxnn/mosaic_wire_fused_v1.cpp device/vxnn/mosaic_wire_coop_v3.cpp device/vxnn/mosaic_wire_reuse_v4.cpp
MOSAIC_PROGRAM_DIR ?= data/nnrt/programs/mosaic-int16-v3
HUNET_PROGRAM_DIR ?= data/nnrt/programs/hunet-fp16-v2
NN_JSON_PREFIX ?= /home/z2euss/workspace/mosaic_hunet_dp_20261018/deps/json-c-0.18-vxl1
NN_JSON_FLAGS = -I$(NN_JSON_PREFIX)/include
NN_JSON_LIBS = $(NN_JSON_PREFIX)/lib/libjson-c.a -lm
CC ?= gcc
CXX ?= g++
OUT ?= build/unified-host
DEBUG_FLAGS ?= -g
UFLAGS = -std=c11 -O2 $(DEBUG_FLAGS) -Wall -Wextra -Werror -Iinclude -I.
UXFLAGS = -std=c++17 -O2 $(DEBUG_FLAGS) -Wall -Wextra -Werror -Iinclude -I. -pthread
ifneq ($(SANITIZE),)
UFLAGS += -fsanitize=$(SANITIZE) -fno-omit-frame-pointer
UXFLAGS += -fsanitize=$(SANITIZE) -fno-omit-frame-pointer
endif
.PHONY: test-unified-freeze
test-unified-freeze:
	$(PYTHON) -m unittest discover -s tests/unified -p test_freeze.py -v
.PHONY: test-unified-wire test-unified-identity
