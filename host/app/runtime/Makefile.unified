# A fresh OUT is bound by the run manifest to compiler/flags/source identity.
# Compile shared scheduler/CPU objects once, link all three tests from them.
SCHED_SOURCES = unified/scheduler/queue.cpp unified/scheduler/dispatch.cpp unified/scheduler/cancel.cpp nnrt/cpu/pool.cpp nnrt/cpu/gelu.cpp
SCHED_OBJECTS = $(addprefix $(OUT)/shared/,$(SCHED_SOURCES:.cpp=.o))
SCHED_HEADERS = $(wildcard include/vxunified/*.hpp include/vxnn/*.hpp unified/scheduler/*.hpp)
.PHONY: test-unified-backend-cookie-order
