$(OUT)/backend/tests/unified/s8_owner_bridge.o: tests/unified/s8_owner_bridge.c tests/unified/s8_owner_bridge.h vendor/image-studio/src/vortex23-image-studio-720p-fast/tests/rv32_image_model.h vendor/image-studio/src/vortex23-image-studio-720p-fast/image_contract.h $(V2_ALL_HEADERS)
