INT16_HOST_MODEL_CPP = device/vxnn/entry.cpp device/vxnn/int16_matmul.cpp device/vxnn/int48_post.cpp device/mosaic_s8/tile.cpp device/mosaic_s8/unpack.cpp tests/mosaic_s8/fake_s8.cpp
