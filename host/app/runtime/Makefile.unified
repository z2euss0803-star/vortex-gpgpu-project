# Fresh OUT object reuse: independent C++ translation units compile in parallel.
U18_CPP = unified/display/owner.cpp unified/display/result_lease.cpp unified/display/compose.cpp unified/service/result.cpp adapters/hunet_result.cpp adapters/hunet_glyph.cpp
U18_C = viewer/viewer.c viewer/frame.c viewer/hunet_frame.c viewer/glyph.c viewer/scale.c demo/json.c demo/store.c core/hunet_sha256.c
U18_OBJ = $(addprefix $(OUT)/display/,$(U18_CPP:.cpp=.o) $(U18_C:.c=.o))
$(OUT)/display/%.o: %.cpp $(wildcard include/vxunified/*.hpp include/vxnn/*.hpp) viewer/kms.h unified/display/internal.hpp tests/unified/display_fixture.hpp
	mkdir -p $(dir $@)
	$(CXX) $(UXFLAGS) $(NN_JSON_FLAGS) -c $< -o $@
$(OUT)/display/%.o: %.c viewer/kms.h include/vxl/demo_frame.h
	mkdir -p $(dir $@)
	$(CC) $(UFLAGS) $(NN_JSON_FLAGS) -c $< -o $@
$(OUT)/test_display: $(OUT)/display/tests/unified/test_display.o $(U18_OBJ)
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) -o $@
$(OUT)/test_page_switch: $(OUT)/display/tests/unified/test_page_switch.o $(U18_OBJ)
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) -o $@
$(OUT)/test_display_pages: $(OUT)/display/tests/unified/test_display_pages.o $(U18_OBJ)
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) -o $@
$(OUT)/test_display_hunet: $(OUT)/display/tests/unified/test_display_hunet.o $(U18_OBJ)
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) -o $@
U18_DRM_FLAGS = $(if $(U18_DRM_PREFIX),-I$(U18_DRM_PREFIX)/include -I$(U18_DRM_PREFIX)/include/libdrm,$(shell pkg-config --cflags libdrm))
U18_DRM_LIBS = $(if $(U18_DRM_PREFIX),$(U18_DRM_PREFIX)/lib/libdrm.a,$(shell pkg-config --libs libdrm))
$(OUT)/display/viewer/kms.o: viewer/kms.c viewer/kms.h
	mkdir -p $(dir $@)
	$(CC) $(UFLAGS) $(U18_DRM_FLAGS) -c $< -o $@
$(OUT)/test_display_native: $(OUT)/display/tests/unified/test_display_native.o $(U18_OBJ) $(OUT)/display/unified/display/native.o $(OUT)/display/viewer/kms.o
	$(CXX) $(UXFLAGS) $^ $(NN_JSON_LIBS) $(U18_DRM_LIBS) -o $@
