.PHONY: test-unified-all test-unified-concurrency
test-unified-all:
	$(PYTHON) -m scripts.unified.run_software $(notdir $(OUT)) normal
test-unified-concurrency:
	$(PYTHON) -m scripts.unified.run_software $(notdir $(OUT)) thread

# U22 actual frozen ELF/source/asset audit; no target execution or device access.
.PHONY: test-unified-cross-audit
test-unified-cross-audit:
	$(PYTHON) -m unittest tests.unified.test_cross_audit tests.unified.test_cross_identity tests.unified.test_cross_assets -v
	$(PYTHON) -c "from scripts.unified.build_rv32 import verify_original_shaders; from scripts.unified.cross_assets import verify_original_assets; import json; a=verify_original_assets('.'); print(json.dumps(dict(scope='STATIC_BYTE_CLOSURE_NOT_TARGET_BUILD_OR_RENDER',original_shaders=len(verify_original_shaders('.')),original_p8_assets=len(a['asset_files']),old_oracles=len(a['oracle_files']),gpu_raw_cycles=None)))"


# U23 actual firmware files through the existing C binder, HOST registers only.
$(OUT)/test_kernel_firmware_bind: tests/unified/test_kernel_firmware_bind.c tests/v2/test_provider.c $(V2_PROVIDER) $(V2_JOB_CORE) driver/v2/execution.c driver/v2/startup.c core/cdma.c $(V2_ALL_HEADERS)
	mkdir -p $(OUT)
	$(CC) $(UFLAGS) $< $(V2_PROVIDER) $(V2_JOB_CORE) driver/v2/execution.c driver/v2/startup.c core/cdma.c -o $@
.PHONY: test-unified-kernel-audit
test-unified-kernel-audit: $(OUT)/test_kernel_firmware_bind
	$(PYTHON) -m unittest tests.unified.test_kernel_audit tests.unified.test_kernel_dt tests.unified.test_kernel_firmware tests.unified.test_kernel_builtin -v
	$(PYTHON) -m scripts.unified.check_kernel_firmware $(OUT)/test_kernel_firmware_bind $(OUT)/production-firmware-bind

# U24 packaging probe: genuine package/registry/planner, declared caps only.
# This host utility is never installed as an application or a GPU fallback.
$(OUT)/image_package_metadata: tests/unified/image_package_metadata.cpp nnrt/models/hunet.cpp nnrt/ops/hunet_registry.cpp device/vxnn/hunet_wire.cpp nnrt/ops/mosaic.cpp nnrt/models/mosaic_plan.cpp nnrt/models/mosaic.cpp nnrt/memory/arena.cpp $(MOSAIC_WIRE_SOURCE) $(NN_PLAN_OBJECTS) $(OUT)/v2/catalog.o
