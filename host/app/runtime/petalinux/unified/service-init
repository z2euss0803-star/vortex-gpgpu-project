#!/bin/sh
### BEGIN INIT INFO
# Provides: vxgpud
# Required-Start: $local_fs $network
# Required-Stop: $local_fs $network
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
### END INIT INFO
set -eu
# Print public boot identity even while GPU service is disabled. Host keys are
# generated by the existing Dropbear startup; no private key bytes are printed.
print_boot_identity() {
 [ -c /dev/console ] || return 0
 printf 'S8_BOOT_IDENTITY build=' >/dev/console
 cat /etc/codex-build-id >/dev/console
 printf 'S8_BOOT_IDENTITY boot=' >/dev/console
 cat /proc/sys/kernel/random/boot_id >/dev/console
 key_tool="$(command -v dropbearkey 2>/dev/null || :)"
 multi_tool="$(command -v dropbearmulti 2>/dev/null || :)"
 for host_key in /etc/dropbear/dropbear_rsa_host_key /etc/dropbear/dropbear_ecdsa_host_key /etc/dropbear/dropbear_ed25519_host_key; do
  [ -f "$host_key" ] || continue
  if [ -n "$key_tool" ]; then
   "$key_tool" -y -f "$host_key" >/dev/console 2>&1 || :
  elif [ -n "$multi_tool" ]; then
   "$multi_tool" dropbearkey -y -f "$host_key" >/dev/console 2>&1 || :
  else
   printf 'S8_BOOT_IDENTITY public-key-tool-unavailable\n' >/dev/console
   break
  fi
 done
}
case "$1" in
 start)
  print_boot_identity
  . /etc/default/vxgpud
  [ "$UNIFIED_SERVICE_ENABLED" = 1 ] || exit 0
  # Check the same sealed declaration before opening the sole device owner.
  /usr/bin/vxgpud --check-config /etc/vxgpud/config.json
  exec /usr/bin/vxgpud --serve /etc/vxgpud/config.json
  ;;
 stop)
  # Match the actual executable, not a stale/guessed PID. SIGTERM invokes the
  # existing graceful daemon shutdown; never SIGKILL or force a device reset.
  . /etc/default/vxgpud
  [ "$UNIFIED_SERVICE_ENABLED" = 1 ] || exit 0
  start-stop-daemon -K -s TERM -x /usr/bin/vxgpud
  ;;
 status) /usr/bin/vxgpuctl --socket /run/vxgpud/control.sock models ;;
 *) echo "Usage: $0 {start|stop|status}" >&2; exit 2 ;;
esac
